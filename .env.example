# Copy to .env and fill in. Never commit .env — this repository is public.
# Every key here is read by rag_core.config.load_config(); nothing reads the
# environment anywhere else.

# Adapter profile resolved once at startup. One of: fake, hosted.
RAG_PROFILE=fake

# --- Embedding ---
# The model id is deliberately a placeholder. The spike confirms which Gemini
# model emits 768-dimension vectors and whether truncation needs
# renormalisation (PRD open question 1); set the real value from its result.
EMBED_MODEL=REPLACE_ME_AFTER_SPIKE
EMBED_DIMENSIONS=768
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_S=120

# --- Generation ---
# Two providers with a fallback chain (ADR-004). The response reports which
# one served it.
PRIMARY_MODEL=REPLACE_ME
SECONDARY_MODEL=REPLACE_ME
GENERATION_TIMEOUT_S=300

# --- Retrieval ---
RETRIEVE_N=10
TOP_K=4
RRF_K=60

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Gate ---
# INVALID until TICKET-8 re-sweeps them. See the comment in rag_core/config.py.
TAU_ABSTAIN=0.70
TAU_STRONG=0.75

HISTORY_MESSAGES=4

# --- Database (hosted profile) ---
# Postgres with the pgvector extension. Neon's pooled endpoint (-pooler host)
# is fine: its PgBouncer supports protocol-level prepared statements, so
# asyncpg needs no statement_cache_size workaround.
# THIS IS A SECRET. Never commit a real value — this repository is public.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=10
