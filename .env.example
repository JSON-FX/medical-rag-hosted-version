# Copy to .env and fill in. Never commit .env — this repository is public.
# Every key here is read by rag_core.config.load_config(); nothing reads the
# environment anywhere else.

# Adapter profile resolved once at startup. One of: fake, hosted.
RAG_PROFILE=fake

# --- Embedding ---
# gemini-embedding-001 is natively 3072-dimensional; the adapter reduces it to
# 768 via output_dimensionality and renormalises, because truncation breaks the
# unit norm cosine similarity depends on.
# THIS IS A SECRET. Never commit a real value — this repository is public.
GEMINI_API_KEY=your-gemini-api-key
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT_S=120

# --- Generation ---
# Two providers with a fallback chain (ADR-004). The response reports which one
# served it. Groq leads on time-to-first-token; Gemini is the independent
# second failure domain.
# THIS IS A SECRET. Never commit a real value — this repository is public.
GROQ_API_KEY=your-groq-api-key
PRIMARY_PROVIDER=groq
PRIMARY_MODEL=llama-3.3-70b-versatile
SECONDARY_PROVIDER=gemini
SECONDARY_MODEL=gemini-2.0-flash
GENERATION_TIMEOUT_S=300

# --- Retrieval ---
RETRIEVE_N=10
TOP_K=4
RRF_K=60

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Gate ---
# INVALID until TICKET-8 re-sweeps them. See the comment in rag_core/config.py.
TAU_ABSTAIN=0.70
TAU_STRONG=0.75

HISTORY_MESSAGES=4

# --- Database (hosted profile) ---
# Postgres with the pgvector extension. Neon's pooled endpoint (-pooler host)
# is fine: its PgBouncer supports protocol-level prepared statements, so
# asyncpg needs no statement_cache_size workaround.
# THIS IS A SECRET. Never commit a real value — this repository is public.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=10
